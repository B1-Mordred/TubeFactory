{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-studio.local/contracts/publish-metadata.schema.json",
  "title": "Immutable YouTube Publishing Metadata",
  "type": "object",
  "required": ["title", "description", "sources", "evidence_url", "chapters", "tags", "category_id", "language", "made_for_kids", "contains_synthetic_media", "captions", "thumbnail"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 5000},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {"title": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}},
        "additionalProperties": false
      }
    },
    "evidence_url": {"type": ["string", "null"], "format": "uri"},
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_seconds", "title"],
        "properties": {"start_seconds": {"type": "integer", "minimum": 0}, "title": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "tags": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1}},
    "category_id": {"type": "string", "pattern": "^[0-9]+$"},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
    "made_for_kids": {"type": "boolean"},
    "contains_synthetic_media": {"type": "boolean"},
    "captions": {
      "type": "object",
      "required": ["asset_id", "content_hash", "language", "name"],
      "properties": {
        "asset_id": {"type": "string", "format": "uuid"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "language": {"type": "string", "minLength": 2},
        "name": {"type": "string", "minLength": 1, "maxLength": 150}
      },
      "additionalProperties": false
    },
    "thumbnail": {
      "type": "object",
      "required": ["asset_id", "content_hash"],
      "properties": {
        "asset_id": {"type": "string", "format": "uuid"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
