{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-studio.local/schemas/script-draft.schema.json",
  "title": "ScriptDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "segments"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "segments": {
      "type": "array",
      "minItems": 8,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_key",
          "segment_type",
          "narration",
          "presentation_purpose",
          "duration_seconds",
          "citation_display",
          "annotations",
          "locked"
        ],
        "properties": {
          "segment_key": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,120}$"},
          "segment_type": {
            "enum": ["hook", "thesis", "context", "evidence", "counterevidence", "conclusion", "uncertainty", "call_to_action"]
          },
          "narration": {"type": "string", "minLength": 1, "maxLength": 20000},
          "presentation_purpose": {"type": "string", "minLength": 1, "maxLength": 2000},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 900},
          "citation_display": {"type": "object", "maxProperties": 20},
          "locked": {"type": "boolean"},
          "annotations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "start_offset", "end_offset", "kind", "claim_ids", "evidence_excerpt_id"],
              "properties": {
                "text": {"type": "string", "minLength": 1, "maxLength": 20000},
                "start_offset": {"type": "integer", "minimum": 0},
                "end_offset": {"type": "integer", "minimum": 1},
                "kind": {"enum": ["fact", "inference", "opinion", "quote", "editorial"]},
                "claim_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "format": "uuid"}
                },
                "evidence_excerpt_id": {"type": ["string", "null"], "format": "uuid"}
              }
            }
          }
        }
      }
    }
  }
}
