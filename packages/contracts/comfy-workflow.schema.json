{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-studio.local/contracts/comfy-workflow.schema.json",
  "title": "Approved ComfyUI API Workflow",
  "type": "object",
  "required": ["workflow_key", "purpose", "api_workflow", "required_nodes", "required_models", "typed_inputs", "output_contract", "allowed_resolutions", "allowed_durations"],
  "properties": {
    "workflow_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,159}$"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 160},
    "api_workflow": {"type": "object", "minProperties": 1},
    "required_nodes": {"type": "array", "items": {"type": "object", "required": ["class_type", "version"], "properties": {"class_type": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false}},
    "required_models": {"type": "array", "items": {"type": "object", "required": ["name", "sha256"], "properties": {"name": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "typed_inputs": {"type": "array", "items": {"type": "object", "required": ["name", "node_id", "input_name", "value_type", "required"], "properties": {"name": {"type": "string"}, "node_id": {"type": "string"}, "input_name": {"type": "string"}, "value_type": {"enum": ["string", "integer", "number", "boolean", "seed"]}, "required": {"type": "boolean"}}, "additionalProperties": false}},
    "output_contract": {"type": "object"},
    "allowed_resolutions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 64, "maximum": 8192}, "height": {"type": "integer", "minimum": 64, "maximum": 8192}}, "additionalProperties": false}},
    "allowed_durations": {"type": "object", "required": ["minimum_seconds", "maximum_seconds"], "properties": {"minimum_seconds": {"type": "number", "minimum": 0.1}, "maximum_seconds": {"type": "number", "maximum": 900}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
